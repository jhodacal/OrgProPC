{
  "name": "orgpro-desktop",
  "version": "1.0.0",
  "description": "OrgPro PC - Life, Study & RPG Organizer for Windows",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
